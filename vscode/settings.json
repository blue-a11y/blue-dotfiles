{
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.formatOnType": true,
  "editor.tabSize": 2,
  "workbench.colorTheme": "Nebula",
  "workbench.productIconTheme": "material-product-icons",
  "cSpell.userWords": [
    "ahooks",
    "aweme",
    "bodyparser",
    "coro",
    "debugpy",
    "duyi",
    "edenx",
    "fastapi",
    "Feibo",
    "meego",
    "nyuk",
    "okee",
    "ondelete",
    "onmove",
    "onupdate",
    "partialize",
    "pycache",
    "pytest",
    "PYTHONDONTWRITEBYTECODE",
    "redoc",
    "rsbuild",
    "selectinload",
    "settinggroup",
    "skus",
    "slardar",
    "tailwindcss",
    "venv",
    "xuan",
    "zhangxuan",
  ],
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "typescript.updateImportsOnFileMove.enabled": "always",
  "terminal.integrated.smoothScrolling": true,
  "workbench.list.smoothScrolling": true,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "editor.fontFamily": "CaskaydiaCove Nerd Font",
  "vscode_custom_css.imports": ["file://${userHome}/.vscode/custom.css"],
  "window.closeWhenEmpty": true,
  "window.confirmBeforeClose": "always",
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
  },
  "explorer.compactFolders": false,
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "editor.fontLigatures": true,
  "editor.fontSize": 13,
  "editor.quickSuggestions": {
    "strings": true,
  },
  "tailwindCSS.emmetCompletions": true,
  "tailwind-fold.autoFold": false,
  "workbench.iconTheme": "material-icon-theme",
  "code-runner.saveFileBeforeRun": true,
  "code-runner.runInTerminal": true,
  "code-runner.executorMap": {
    "python": "$pythonPath -u $fullFileName",
  },
  "editor.inlineSuggest.enabled": false,
  "github.copilot.enable": {
    "*": false,
  },
  "github.copilot.nextEditSuggestions.enabled": false,
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.formatOnType": false,
  },
  "terminal.integrated.scrollback": 3000,
  "open-in-browser.default": "chrome",
  "editor.cursorBlinking": "expand",
  "workbench.sideBar.location": "right",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorStyleInactive": "underline",
  "terminal.integrated.cursorWidth": 3,
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.fontSize": 14,
  "html.autoClosingTags": false,
  "javascript.autoClosingTags": false,
  "typescript.autoClosingTags": false,
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "editor.wordWrap": "on",
  "workbench.browser.showInTitleBar": false,
  "window.commandCenter": false,
  "window.titleBarStyle": "native",
  "chat.titleBar.openInAgentsWindow.enabled": false,
  "workbench.layoutControl.enabled": false,
  "vim.autoSwitchInputMethod.enable": true,
  "vim.autoSwitchInputMethod.defaultIM": "com.apple.keylayout.ABC",
  "vim.autoSwitchInputMethod.switchIMCmd": "/bin/sh -c 'exec \"$HOME/.local/bin/vim-im-force-abc\" \"$1\"' -- {im}",
  "vim.autoSwitchInputMethod.obtainIMCmd": "/bin/sh -c 'exec \"$HOME/.local/bin/vim-im-force-abc\" --current'",
  "vim.useSystemClipboard": true,
  "python.autoComplete.extraPaths": [],
  "python.analysis.typeCheckingMode": "standard",
  "editor.accessibilitySupport": "off",
  "workbench.browser.openLocalhostLinks": false,
  "git.openRepositoryInParentFolders": "never",
  "jupyter.widgetScriptSources": ["jsdelivr.com", "unpkg.com"],
  "workbench.activityBar.location": "top",
  "chat.viewSessions.orientation": "stacked",
  "window.customTitleBarVisibility": "never",
  "markdown.preview.typographer": true,
  "workbench.editorAssociations": {
    "*.copilotmd": "vscode.markdown.preview.editor",
    "{hexdiff}:/**/*.*": "hexEditor.hexedit",
    "*.md": "vscode.markdown.preview.editor",
  },
}
